<div>
  {%
  lava
  assign x = 1
  assign y = 2
  if A
  assign z = 1
  endif
  %}
</div>
<div>
  {%- lava
  assign x = 1
  assign y = 2
  if A
  assign z = 1
  endif -%}
</div>

It should reindent and format
{%- lava
if empty and true
render 'icon-cart-empty'
else
render 'icon-cart'
endif
-%}

It should handle comments correctly
{%- lava
comment
how u doin?
endcomment -%}

It should handle nested comments correctly
{%- lava
comment
how u doin?
comment
ho
endcomment
endcomment -%}

It should handle empty nested comments correctly
{%- lava
comment
how u doin?
comment
endcomment
endcomment -%}

It should convert invalid # inline comments to //- at the top level
{%- lava
# heyy how u doin
# not too bad
#
# you? -%}

It should convert decorative # lines to //- (# is invalid in Rock)
{%- lava
#############
# fancy
#############
-%}

It should keep at most one empty new line between statements, and strip trailing
{% lava
# some reason
if cond

echo foo


echo bar

else
echo bar
endif


# some other block
case foo
when bar,baz
echo 'hi'

else
echo 'no'
endcase

%}

It should parse tags properly and print them properly
printWidth: 1
{% lava
assign x = thing['property']|filter1|fitler2
echo x |filter1| filter2
capture var
if nil
echo true
else
echo false
endif
endcapture
cycle 'one', 'two', 'three'

for x in col reversed limit:10
echo x
else
echo 'nope'
endfor

tablerow x in col
echo 'huh?'
endtablerow

increment i
%}

It should keep newlines between tags
{% lava
# comment 1

# comment 2
if cond
echo foo

echo bar
endif
%}

It should keep leading whitespace in comments
{% lava
# This list should not be reindented:
# - a
# - b
# - d
# - c
%}

It should nest a bare comment/endcomment block inside an if (Rock rejects //- and /- -/ inside a lava tag)
{% lava
if condition
comment
This is a comment inside an if block.
endcomment
echo something
endif
%}

It should preserve //- and /- -/ comments at the top level of a lava tag
{% lava
//- a line comment
/-
a block
comment
-/
echo 'Hello World'
%}

It should convert top-level # to //- but keep //- and /- -/ as-is
{% lava
# convert me
//- keep me
/-
keep me too
-/
%}

It should convert //- and /- -/ to comment/endcomment inside any nested block
{% lava
if cond
//- dash line becomes comment block
/-
dash block becomes comment block
-/
echo 'foo'
endif
%}

It should convert # to comment/endcomment inside a nested block
{% lava
for x in col
# this hash becomes a comment block
echo x
endfor
%}

It should put converted single-line /- -/ delimiters on their own lines inside a block
{% lava
if cond
/- what about this-/
echo 'x'
endif
%}
