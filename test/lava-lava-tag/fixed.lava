<div>
  {% lava
    assign x = 1
    assign y = 2
    if A
      assign z = 1
    endif
  %}
</div>
<div>
  {%- lava
    assign x = 1
    assign y = 2
    if A
      assign z = 1
    endif
  -%}
</div>

It should reindent and format
{%- lava
  if empty and true
    render 'icon-cart-empty'
  else
    render 'icon-cart'
  endif
-%}

It should handle comments correctly
{%- lava
  //- how u doin?
-%}

It should handle nested comments correctly
{%- lava
  /-
    how u doin?
    comment
    ho
    endcomment
  -/
-%}

It should handle empty nested comments correctly
{%- lava
  /-
    how u doin?
    comment
    endcomment
  -/
-%}

It should convert invalid # inline comments to //- at the top level
{%- lava
  //- heyy how u doin
  //- not too bad
  //-
  //- you?
-%}

It should convert decorative # lines to //- (# is invalid in Rock)
{%- lava
  //- ############
  //- fancy
  //- ############
-%}

It should keep at most one empty new line between statements, and strip trailing
{% lava
  //- some reason
  if cond
    echo foo

    echo bar

  else
    echo bar
  endif

  //- some other block
  case foo
    when bar or baz
      echo 'hi'

    else
      echo 'no'
  endcase
%}

It should parse tags properly and print them properly
printWidth: 1
{% lava
  assign x = thing.property | filter1 | fitler2
  echo x | filter1 | filter2
  capture var
    if null
      echo true
    else
      echo false
    endif
  endcapture
  cycle 'one', 'two', 'three'

  for x in col reversed limit:10
    echo x
  else
    echo 'nope'
  endfor

  tablerow x in col
    echo 'huh?'
  endtablerow

  increment i
%}

It should keep newlines between tags
{% lava
  //- comment 1

  //- comment 2
  if cond
    echo foo

    echo bar
  endif
%}

It should keep leading whitespace in comments
{% lava
  //- This list should not be reindented:
  //- - a
  //- - b
  //- - d
  //- - c
%}

It should convert a comment/endcomment block inside an if to //- (Rock breaks on comment/endcomment inside a lava tag)
{% lava
  if condition
    //- This is a comment inside an if block.
    echo something
  endif
%}

It should preserve //- and /- -/ comments at the top level of a lava tag
{% lava
  //- a line comment
  /-
    a block
    comment
  -/
  echo 'Hello World'
%}

It should convert top-level # to //- but keep //- and /- -/ as-is
{% lava
  //- convert me
  //- keep me
  /-
    keep me too
  -/
%}

It should keep //- and /- -/ comments as-is inside any nested block
{% lava
  if cond
    //- dash line stays a dash comment
    /-
      dash block stays a dash comment
    -/
    echo 'foo'
  endif
%}

It should convert # to //- inside a nested block
{% lava
  for x in col
    //- this hash becomes a line comment
    echo x
  endfor
%}

It should keep a single-line /- -/ comment inline inside a block
{% lava
  if cond
    /- what about this-/
    echo 'x'
  endif
%}

It should convert an empty comment/endcomment block to //-
{% lava
  //-
%}

It should fall back to //- per line when a comment body contains -/
{% lava
  //- first line
  //- has a -/ in it
%}
