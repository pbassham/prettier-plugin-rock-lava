{
  "name": "prettier-plugin-rock-lava",
  "version": "0.10.3",
  "description": "Prettier Lava/HTML plugin for Rock RMS",
  "repository": "pbassham/prettier-plugin-rock-lava",
  "author": {
    "name": "Philip Bassham",
    "url": "https://github.com/pbassham"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/pbassham/prettier-plugin-rock-lava/issues"
  },
  "files": [
    "grammar/*",
    "dist/**/*.js",
    "dist/**/*.ts",
    "standalone.js",
    "standalone.d.ts",
    "standalone.js.LICENSE.txt",
    "ThirdPartyNotices.txt"
  ],
  "scripts": {
    "build": "bun run build:shims && bun run build:ts && bun run build:standalone",
    "build:shims": "node build/shims.js",
    "build:standalone": "webpack -c webpack.config.js",
    "build:local": "bun run build && bun run copyto:playground",
    "copyto:playground": "cp ./standalone.js ./playground/assets/standalone.js",
    "build:ts": "tsc -p tsconfig.build.json; tsc-alias -p tsconfig.build.json",
    "coverage": "nyc bun run test",
    "coverage:json": "nyc --reporter=json bun run test",
    "coverage:lcov": "nyc --reporter=lcov bun run test",
    "debug": "node --inspect-brk node_modules/.bin/_mocha \"{src,test}/**/*.ts\"",
    "format": "scripts/relative-to-alias && prettier --write --ignore-unknown \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check --ignore-unknown \"{src,test}/**/*.ts\"",
    "playground": "npx http-server playground",
    "preview": "node -r ./build/shims -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/preview.ts",
    "bless": "node -r ./build/shims -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/bless.ts",
    "prepare": "husky install",
    "prerelease": "scripts/prerelease",
    "prettier": "scripts/prettier",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "test": "node_modules/.bin/mocha '{src,test}/**/*.spec.ts'",
    "test:idempotence": "cross-env TEST_IDEMPOTENCE=true node_modules/.bin/mocha 'test/**/*.spec.ts'",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@tsconfig/node14": "^1.0.1",
    "@types/chai": "^4.2.22",
    "@types/line-column": "^1.0.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^16.11.11",
    "chai": "^4.3.4",
    "cross-env": "^7.0.3",
    "husky": "^7.0.0",
    "mocha": "^9.1.3",
    "nyc": "^15.1.0",
    "prettier": "^3.0.0",
    "pretty-quick": "^3.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.6.7",
    "tsconfig-paths": "^3.14.1",
    "typescript": "^4.5.2",
    "webpack": "^5.70.0",
    "webpack-cli": "^4.9.2"
  },
  "dependencies": {
    "html-styles": "^1.0.0",
    "line-column": "^1.0.2",
    "ohm-js": "^16.3.0",
    "sql-formatter": "^15.8.0"
  }
}
